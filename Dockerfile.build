# Dockerfile.build — builds and tests the swarm binary inside a Go+CGO environment.
#
# Use this when Go is not installed on the host (e.g. Windows without Go).
# go-duckdb requires CGO + GCC; both are bundled here.
#
# Build + test + extract binary:
#
#   docker build -f Dockerfile.build --output bin .
#
# This runs `go test ./...` across all modules before producing the binary.
# The build fails and produces nothing if any test fails.
#
# Then run with the runtime image:
#
#   docker compose up
#
# NOTE: produces a Linux/amd64 binary. Run it in Docker (see Dockerfile) or WSL2.

# ── Stage 1: dependency cache ─────────────────────────────────────────────────
FROM golang:1.23-bullseye AS deps

# GCC is required by go-duckdb CGO bindings.
RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc libc-dev \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Copy workspace + module files first so dependency downloads are cached
# separately from source changes.
COPY go.work ./
COPY src/obs/go.mod         ./src/obs/
COPY src/orchestrator/go.mod ./src/orchestrator/

RUN cd src/obs          && go mod download || true
RUN cd src/orchestrator && go mod download || true

# ── Stage 2: test ─────────────────────────────────────────────────────────────
FROM deps AS tester

# Copy full source.
COPY src/obs/         ./src/obs/
COPY src/orchestrator/ ./src/orchestrator/

# Run all tests. Build fails here if any test fails.
# The -count=1 flag disables the test cache so tests always run fresh.
RUN CGO_ENABLED=1 go test -count=1 -v ./src/obs/... \
 && CGO_ENABLED=1 go test -count=1 -v ./src/orchestrator/...

# ── Stage 3: compile ──────────────────────────────────────────────────────────
FROM tester AS builder

RUN mkdir -p /out \
 && CGO_ENABLED=1 GOOS=linux GOARCH=amd64 \
    go build -C src/orchestrator -o /out/swarm ./cmd/swarm

# ── Stage 4: export binary via: docker build --output bin . ──────────────────
FROM scratch AS export
COPY --from=builder /out/swarm /swarm
